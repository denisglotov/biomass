local level_manager = require "scripts.level_manager"

function init(self)
    msg.post(".", "acquire_input_focus")
    msg.post("@render:", "use_fixed_fit_projection")
    self.current_level_id = 1
    self.level_config = level_manager.get_level(self.current_level_id)
    print("Biomass Defold Initialized. Loaded Level " .. self.current_level_id .. ": " .. self.level_config.title)
end

function on_input(self, action_id, action)
    if action_id == hash("touch") and action.pressed then
        msg.post("#hud", "click_at", { x = action.x, y = action.y })
    elseif action_id == hash("undo") and action.pressed then
        msg.post("#hud", "trigger_undo")
    elseif action_id == hash("reset") and action.pressed then
        msg.post("#hud", "trigger_reset")
    elseif action_id == hash("end_turn") and action.pressed then
        msg.post("#hud", "trigger_end_turn")
    end
end

function on_message(self, message_id, message, sender)
    -- State managed by hud.gui_script
end
